<%- include('partials/header') %>

<main class="auth-page">
    <section class="auth-panel" aria-labelledby="signin-heading">
        <h1 id="signin-heading">Log in</h1>

        <% if (error) { %>
            <p role="alert"><%= error %></p>
        <% } %>

        <form action="/signin" method="POST" class="auth-form">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" value="<%= name %>" autocomplete="name" required>

            <label for="email">Email</label>
            <input id="email" name="email" type="email" value="<%= email %>" autocomplete="email" required>

            <label for="phoneNumber">Phone number</label>
            <input id="phoneNumber" name="phoneNumber" type="tel" value="<%= phoneNumber %>" autocomplete="tel" required>

            <button type="submit">Log in</button>
        </form>

        <p><a href="/books">Return to books</a></p>
    </section>
</main>

<%- include('partials/footer') %>
