<!-- button will post a reservation object to reservation database with fields-->
<form action="/computer" method="POST">
        <div class="form-group">
          <label for="library-card">Enter library card to reserve</label>
          <input type="text" name="library-card">
          <label for="computerid">Enter Computer ID you want to reserve</label>
          <input type="number" name="computerid">
        </div>
        <button type="submit">Reserve</button>
