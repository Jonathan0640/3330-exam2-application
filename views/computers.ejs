<%- include('partials/header') %>


<h1>Welcome to computers :D</h1>

<% computers.forEach((computer) => { %>
        <div class="card">
                <img src="/images/computer.png" alt="computer image" class="card-img">
                <div class="card-body">
                <h3 class="card-title">ComputerID: <%= computer.computerID %></h3>
                <p class="card-text">Location: <%= computer.location %></p>
                </div>
        </div>
<% }); %>

<!-- button will post a reservation object to reservation database with fields-->
<form action="/computers" method="POST">
        <div class="form-group">
          <label for="library-card">Enter library card to reserve</label>
          <input type="text" name="librarycard">
          <br>
          <label for="computerid">Enter Computer ID you want to reserve</label>
          <input type="number" name="computerid">
        </div>
        <button type="submit">Reserve</button>
</form>


<%- include('partials/footer') %>