<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
  <meta charset="utf-8">
  <title>Library</title>
  <link href="https://fonts.cdnfonts.com/css/w95fa" rel="stylesheet">
  <link href="/css/styles.css" rel="stylesheet">
  
<!-- referenced from 3330-security-main assignment when making the partials for header and footer ejs -->


</head>

<body>
  <header>
    <nav>
      <a class="quick-nav" href="/" role='button'>Home</a>
      <a class="quick-nav" href="/books" role='button'>Books</a>
      <a class="quick-nav" href="/computers" role='button'>Computers</a>
      <div class="quick-nav-signin">
        <% if (user) { %>
          <span>Hello, <%= user.name || user.username || 'there' %></span>
          <% if (user.role === 'admin') { %>
            <a class="quick-nav" href="/admin" role="button">Admin</a>
          <% } %>
        <% } else { %>
          <a class="quick-nav" href="/signin" role="button">Log In</a>
          <a class="quick-nav" href="/signup" role="button">Sign Up</a>
        <% } %>
      </div>
    </nav>
  </header>
