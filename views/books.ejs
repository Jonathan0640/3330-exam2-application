<%- include('partials/header') %>

<main class="books-page">
    <h1>Books</h1>

    <% if (message) { %>
        <p role="status"><%= message %></p>
    <% } %>

    <section class="books-grid" aria-label="Book catalog">
        <% books.forEach((book) => { %>
            <article class="card">
                <% if (book.img) { %>
                    <img src="<%= book.img %>" alt="Cover of <%= book.name %>" class="card-img">
                <% } %>
                <div class="card-body">
                    <h2 class="card-title"><%= book.name %></h2>
                    <p class="card-text">Author: <%= book.author %></p>
                    <p class="card-text">Genre: <%= book.genre %></p>
                    <p class="card-text">Age rating: <%= book.Age_Rating %>+</p>
                    <p class="card-text">Location: <%= book.location %></p>

                    <% if (book.reserved) { %>
                        <p>Reserved</p>
                    <% } else if (user) { %>
                        <form action="/books/<%= book.id %>/reserve" method="POST">
                            <button type="submit">Reserve</button>
                        </form>
                    <% } else { %>
                        <a href="/signin">Sign in to reserve this book</a>
                    <% } %>
                </div>
            </article>
        <% }); %>
    </section>

    <% if (user && user.role === 'admin') { %>
        <p><a href="/admin">Open admin page</a></p>
    <% } %>
</main>

<%- include('partials/footer') %>
